# Copy to .env for local dev. On Railway set these as environment variables.

STARTING_CAPITAL=1000.0
RISK_PCT=2.0
RR_RATIO=1.5

# SQLite path — Railway: mount a volume at /data, set DB_PATH=/data/trades.db
# Local dev:  DB_PATH=trades.db
DB_PATH=/data/trades.db

# Optional Telegram alerts
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
